{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "API Studio",
  "version": "0.1.2",
  "identifier": "dev.apistudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "API Studio",
        "width": 1320,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false,
        "backgroundColor": "#17191F"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi", "nsis"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Spanish", "English"] },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "category": "DeveloperTool",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "publisher": "Derian Molina Lopez",
    "shortDescription": "Cliente HTTP local y rápido",
    "longDescription": "Cliente HTTP de escritorio para desarrollo y pruebas de APIs. Sin nube, sin cuentas.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
